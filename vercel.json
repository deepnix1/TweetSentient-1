{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/tweets/generate.js": {
      "maxDuration": 30
    },
    "api/tweets/history.js": {
      "maxDuration": 10
    },
    "api/tweets/stats.js": {
      "maxDuration": 10
    }
  }
}